{
    "compilerOptions": {
        "target": "es2019",
        "outDir": "./dist",
        "module": "commonjs",
        "lib": ["ES2022"],
        "moduleResolution": "node",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["jest"],
        "sourceMap": true,
        "declaration": true,
        "emitDeclarationOnly": false
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": ["node_modules", "dist", "tests", "**/*.spec.ts"]
}

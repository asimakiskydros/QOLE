{
  "name": "qole",
  "version": "2.2.2",
  "main": "./dist/circuit.js",
  "types": "./dist/circuit.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:custom": "jest --reporters='./scripts/jest-reporter.js'",
    "test:debug": "node --inspect-brk ./node_modules/.bin/jest --watch --runInBand"
  },
  "keywords": [
    "QOLE",
    "Quantum Simulator",
    "Quantum Circuit",
    "Many Qubits",
    "Lazy Evaluation",
    "Quantum Multi-Valued Decision Diagram",
    "QMDD",
    "JavaScript",
    "TypeScript"
  ],
  "author": "Asimakis Kydros",
  "license": "MPL-2.0",
  "description": "The Quantum Operations Lazy Evaluator is a simulator for executing Quantum Circuits, leveraging the memory-compactness of QMDDs.",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "exports": {
    ".": {
      "require": "./dist/circuit.js",
      "types": "./dist/circuit.d.ts"
    },
    "./gates": {
      "require": "./dist/gates.js",
      "types": "./dist/gates.d.ts"
    },
    "./qmdd": {
      "require": "./dist/qmdd.js",
      "types": "./dist/qmdd.d.ts"
    },
    "./complex": {
      "require": "./dist/complex.js",
      "types": "./dist/complex.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asimakiskydros/QOLE.git"
  }
}
